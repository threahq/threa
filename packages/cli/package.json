{
  "name": "@threahq/cli",
  "version": "0.1.0",
  "description": "Command-line client and MCP server for Threa: read and search streams, send messages, manage attachments, and serve the Threa tools to any MCP-capable agent.",
  "keywords": [
    "threa",
    "cli",
    "mcp",
    "agent"
  ],
  "license": "MIT",
  "homepage": "https://threa.io/developers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/threahq/threa.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/threahq/threa/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "threa": "./src/cli.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun ../../extensions/scripts/build-package.ts && mkdir -p dist/skills && cp -R ../../.agents/skills/threa-cli dist/skills/",
    "pack": "bun run build && cd dist && npm pack --pack-destination .."
  },
  "dependencies": {
    "@hpke/core": "^1.9.0",
    "@hpke/dhkem-x25519": "^1.6.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "hash-wasm": "^4.12.0",
    "ulid": "^2.3.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "bun-types": "latest",
    "typescript": "^5"
  }
}
