FROM oven/bun:1.3.14@sha256:e10577f0db68676a7024391c6e5cb4b879ebd17188ab750cf10024a6d700e5c4 AS base
WORKDIR /app

# Copy lockfile + all workspace package.json for frozen-lockfile compatibility
COPY package.json bun.lock ./
COPY packages/types/package.json packages/types/
COPY packages/prosemirror/package.json packages/prosemirror/
COPY packages/crypto/package.json packages/crypto/
COPY packages/agent-runtime/package.json packages/agent-runtime/
COPY packages/backend-common/package.json packages/backend-common/
COPY packages/cli/package.json packages/cli/
COPY apps/backend/package.json apps/backend/
COPY apps/frontend/package.json apps/frontend/
COPY apps/workspace-router/package.json apps/workspace-router/
COPY apps/control-plane/package.json apps/control-plane/
COPY apps/backoffice/package.json apps/backoffice/
COPY apps/backoffice-router/package.json apps/backoffice-router/
COPY apps/db-read-proxy/package.json apps/db-read-proxy/
COPY apps/enclave/package.json apps/enclave/
COPY apps/public-site/package.json apps/public-site/
COPY patches/ patches/
# Remove prepare script (husky) so post-install scripts still run (sharp needs native binaries)
RUN sed -i '/"prepare"/d' package.json && bun install --frozen-lockfile --production

# Copy source
COPY packages/types/ packages/types/
COPY packages/prosemirror/ packages/prosemirror/
COPY packages/crypto/ packages/crypto/
COPY packages/agent-runtime/ packages/agent-runtime/
COPY packages/backend-common/ packages/backend-common/
COPY packages/cli/ packages/cli/
# The CLI imports these sources, which resolve their packages from the CLI's.
COPY extensions/bot-runtime-client/src/ extensions/bot-runtime-client/src/
RUN ln -s ../../packages/cli/node_modules extensions/bot-runtime-client/node_modules
COPY apps/backend/ apps/backend/
# Sandboxes get the CLI bundled at runtime: fail the image, not the first box.
RUN bun -e 'const f = await (await import("./apps/backend/src/features/sandboxes/box-files.ts")).buildBoxFiles(); await Bun.write("/tmp/threa.js", f.cli)' \
  && bun /tmp/threa.js --help > /dev/null && rm /tmp/threa.js

ENV NODE_ENV=production
EXPOSE 3001
CMD ["bun", "apps/backend/src/index.ts"]
