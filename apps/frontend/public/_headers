# Default: always revalidate. Cloudflare Pages caches aggressively by
# default, which can leave stale index.html referencing old content-hashed
# asset filenames after a deploy. The app shell should always be checked
# before reuse; only hashed assets are immutable.
/*
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

# Hashed assets (Vite output): immutable because filenames change on
# every build. Let browsers and Cloudflare cache indefinitely.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
