---
import Layout from "../layouts/Layout.astro"
import SvgDefs from "../components/SvgDefs.astro"
import SiteHeader from "../components/SiteHeader.astro"
import SiteFooter from "../components/SiteFooter.astro"

// A top-level 404.html disables Cloudflare Pages' implicit SPA fallback.
---

<Layout title="Page not found · Threa" description="That page doesn't exist.">
  <SvgDefs />
  <SiteHeader />

  <main id="main">
    <section class="section hero" aria-labelledby="nf-title">
      <div class="wrap">
        <h1 id="nf-title" class="h1">That page doesn't exist.</h1>
        <p class="lede nf-lede">
          Check the address or <a href="/">return to the home page</a>.
        </p>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>

<style>
  .nf-lede {
    margin-top: 24px;
  }
</style>
