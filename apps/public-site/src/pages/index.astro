  <script is:inline>
  /* Auto-scroll on each beat so newly-faded-in rows come into view. The
     list is naturally scrollable; once the user interacts (wheel, touch,
     keyboard) we surrender the scroll and never fight them. */
  (function () {
    const tlm = document.querySelector('.tl-messages')
    if (!tlm) return

    /* ---- local time stamps ----
       Replace the hardcoded weekday/HH:mm with the user's actual local
       day and a now-anchored cadence: 4/2/0 minutes ago, with Alex and
       Ariadne both at "now" (Ariadne's reply follows immediately on send).
       Day name is computed per stamp so messages that cross midnight
       still read correctly. */
    const now = new Date()
    const dayOf = d => d.toLocaleDateString(undefined, { weekday: 'long' })
    const pad = n => String(n).padStart(2, '0')
    const hhmm = d => `${pad(d.getHours())}:${pad(d.getMinutes())}`
    const ago = mins => new Date(now.getTime() - mins * 60_000)
    const stamps = {
      maya: ago(4),
      jordan: ago(2),
      alex: ago(0),
      ariadne: now,
    }
    document.querySelectorAll('[data-time]').forEach(el => {
      const d = stamps[el.dataset.time] || now
      el.textContent = `${dayOf(d)} ${hhmm(d)}`
    })
    document.querySelectorAll('[data-time-short]').forEach(el => {
      const d = stamps[el.dataset.timeShort] || now
      el.textContent = hhmm(d)
    })
    const cap = document.querySelector('.tl-caption .meta')
    if (cap) cap.textContent = `/ ${dayOf(now)} · 5 messages`

    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return

    const cycle = 22_000
    const start = performance.now()

    /* ---- composer typewriter ----
       Real <input>, driven by JS — value changes trigger the browser's
       native caret which sits at the correct end-of-text position and
       blinks the same way it does anywhere else in the OS. Faster than a
       fake caret: ~100ms/char so it reads as confident, casual typing
       rather than a slow demo loop. */
    const editor = document.querySelector('.composer-editor')
    const input = document.querySelector('.composer-input')
    const trailText = input?.dataset.trail ?? ''
    /* 30% — mention pill snaps in, typing begins
       36% — finished typing " do you know?" (~85ms/char)
       49% — send fires, input clears, mention pill collapses */
    const mentionInPct = 30, typeStartPct = 30, typeEndPct = 36, clearPct = 49
    let lastChars = -1
    let focused = false
    const updateInput = (t) => {
      if (!input || !editor) return
      const pct = (t / cycle) * 100
      const mentionIn = pct >= mentionInPct && pct < clearPct
      editor.classList.toggle('has-mention', mentionIn)
      let chars
      if (pct < typeStartPct) chars = 0
      else if (pct < typeEndPct) {
        const p = (pct - typeStartPct) / (typeEndPct - typeStartPct)
        chars = Math.floor(p * trailText.length)
      } else if (pct < clearPct) chars = trailText.length
      else chars = 0
      if (chars !== lastChars) {
        input.value = trailText.slice(0, chars)
        lastChars = chars
      }
      /* Focus once on first frame so the browser-drawn caret is visible
         in the empty input from the start of the loop. */
      if (!focused) {
        try { input.focus({ preventScroll: true }) } catch { input.focus() }
        focused = true
      }
    }
    const tick = (now) => {
      const t = now - start
      updateInput(t)
      if (t < cycle) requestAnimationFrame(tick)
    }
    requestAnimationFrame(tick)

    /* ---- beat-based auto-scroll ----
       Each beat scrolls the bottom of the latest revealed row into view.
       If the user has manually scrolled, the auto-scroll backs off. */
    let userScrolled = false
    const surrender = () => { userScrolled = true }
    tlm.addEventListener('wheel', surrender, { passive: true })
    tlm.addEventListener('touchstart', surrender, { passive: true })
    tlm.addEventListener('keydown', surrender)

    const scrollToBottom = () => {
      if (userScrolled) return
      tlm.scrollTo({ top: tlm.scrollHeight - tlm.clientHeight, behavior: 'smooth' })
    }

    /* Beat times (percent of cycle, +small lag so opacity has resolved). */
    const beats = [49.5, 51.5, 71.5, 85.5]
    beats.forEach(p => setTimeout(scrollToBottom, p * cycle / 100))
  })()
  </script>

  <script is:inline>
  /* "Bring your own ___" word reel. Slides the track up one line per beat.
     The last word is a clone of the first; when we land on it we snap the
     track back to the top with the transition off, so the loop is seamless. */
  (function () {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return
    const track = document.querySelector('.byo-track')
    if (!track) return
    const lastIndex = track.querySelectorAll('.byo-word').length - 1 // clone
    let i = 0
    const advance = () => {
      i += 1
      track.style.transform = `translateY(-${i * 1.3}em)`
      if (i === lastIndex) {
        setTimeout(() => {
          track.style.transition = 'none'
          i = 0
          track.style.transform = 'translateY(0)'
          void track.offsetHeight /* reflow so the next slide animates */
          track.style.transition = ''
        }, 560)
      }
    }
    setInterval(advance, 2200)
  })()
  </script>

  <script is:inline define:vars={{ apiBase }}>
  /* Waitlist signup. Validates on the client for fast feedback, then POSTs to
     the control-plane (via the workspace-router). The server validates
     authoritatively and dedupes; a repeat email still resolves as success. */
  (function () {
    const form = document.getElementById("waitlist-form")
    if (!form) return
    const email = document.getElementById("wl-email")
    const hp = document.getElementById("wl-hp")
    const submit = document.getElementById("wl-submit")
    const status = document.getElementById("wl-status")
    const idle = "/ early 2026 · no spam"

    const setStatus = (msg, kind) => {
      status.textContent = msg
      status.classList.remove("is-ok", "is-err")
      if (kind) status.classList.add(kind)
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault()
      const value = (email.value || "").trim()
      if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(value)) {
        setStatus("Enter a valid email address.", "is-err")
        email.focus()
        return
      }

      const original = submit.textContent
      submit.disabled = true
      submit.textContent = "Joining…"
      setStatus(idle)

      try {
        const res = await fetch(apiBase + "/api/waitlist", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email: value, source: "home", hp: hp.value || "" }),
        })
        if (!res.ok) throw new Error("status " + res.status)
        form.reset()
        submit.textContent = "Joined"
        setStatus("You're on the list. I'll be in touch.", "is-ok")
      } catch {
        submit.disabled = false
        submit.textContent = original
        setStatus("Something went wrong. Try again.", "is-err")
      }
    })
  })()
  </script>
