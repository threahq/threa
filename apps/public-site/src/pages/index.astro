---
import Layout from "../layouts/Layout.astro"
import SvgDefs from "../components/SvgDefs.astro"
import SiteHeader from "../components/SiteHeader.astro"
import SiteFooter from "../components/SiteFooter.astro"
import Message from "../components/Message.astro"
import TraceCard from "../components/TraceCard.astro"
import AppStreamHeader from "../components/AppStreamHeader.astro"
import AppComposer from "../components/AppComposer.astro"
import MemoEmbed from "../components/MemoEmbed.astro"
import MemoSaved from "../components/MemoSaved.astro"
import WaitlistBand from "../components/WaitlistBand.astro"
import { apiBase } from "../lib/config"
import type { InstallPlatform } from "../lib/install-platform"

const appHost = new URL(apiBase).host
const installTabs: { platform: InstallPlatform; label: string }[] = [
  { platform: "ios", label: "iPhone & iPad" },
  { platform: "android", label: "Android" },
  { platform: "chromium", label: "Chrome, Edge" },
  { platform: "mac-safari", label: "Safari on Mac" },
  { platform: "firefox", label: "Firefox" },
]

// URLs derive from astro.config.mjs's site so the @id cross-reference always
// matches the Organization entity BaseHead emits.
const site = Astro.site!
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Threa",
    url: site.href,
    description:
      "Team chat with memory at its core: decisions and their reasoning become searchable memos linked to the conversation. Open source, with a public REST API and bot runtime for connecting your own agents.",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    softwareHelp: { "@type": "CreativeWork", url: new URL("/developers", site).href },
    publisher: { "@id": new URL("/#organization", site).href },
  },
]
---

<Layout schema={schema}>
  <SvgDefs />
  <SiteHeader current="product" />

  <main id="main">
    <section class="section hero" aria-labelledby="hero-title">
      <div class="wrap split hero-copy">
        <h1 id="hero-title" class="h1">Chat that remembers the decisions.</h1>
        <div class="hero-side">
          <p class="lede">
            Team chat with a memory underneath. When your team settles something,
            the decision and the why stay attached to the messages, so when the
            question comes back in three months there's an answer instead of a
            re-litigation.
          </p>
          <div class="actions">
            <a class="btn btn-primary" href="#waitlist">Join the waitlist</a>
            <a class="text-link" href="#memory">How it remembers</a>
          </div>
          <p class="status-line">Free during early access. Runs in your browser and <a href="#install">installs on any device</a>, <a href="#agents">works with your own coding agent</a>, and <a href="#open-source">its code is public</a>. See <a href="#privacy">what Threa can read</a> and <a href="#your-data">how to get your data out</a>.</p>
        </div>
      </div>

      <div class="wrap">
        <figure class="app-window app-ui" aria-label="Threa's #sprint-planning channel. Maya asks Ariadne why the auth refactor was paused; Ariadne answers from a decision memo saved on March 12, quoting Jordan's original message, and the memo is open beside the conversation.">
          <div class="aw-sidebar" aria-hidden="true">
            <div class="aws-head">
              <span class="app-ib"><svg><use href="#icon-panelleft" /></svg></span>
              <span class="aws-ws"><svg class="aws-logo"><use href="#threa-mark" /></svg><span>Threa</span></span>
              <span class="app-ib"><svg><use href="#icon-search" /></svg></span>
              <span class="app-ib"><svg><use href="#icon-command" /></svg></span>
            </div>
            <div class="aws-body">
              <p class="aws-link aws-board"><svg><use href="#icon-grid" /></svg>Board<svg class="aws-end"><use href="#icon-arrowright" /></svg></p>
              <p class="aws-section"><svg><use href="#icon-chevron" /></svg>Quick links</p>
              <p class="aws-link"><svg><use href="#icon-fileedit" /></svg>Drafts</p>
              <p class="aws-link"><svg><use href="#icon-bookmark" /></svg>Saved</p>
              <p class="aws-link"><svg><use href="#icon-brain" /></svg>Memory</p>
              <p class="aws-section"><svg><use href="#icon-chevron" /></svg>Scratchpads</p>
              <p class="aws-stream"><span class="aws-tile is-pad"><svg><use href="#icon-fileedit" /></svg></span>Rotation notes<svg class="aws-lock"><use href="#icon-lock" /></svg></p>
              <p class="aws-section"><svg><use href="#icon-chevron" /></svg>Channels</p>
              <p class="aws-stream"><span class="aws-tile"><svg><use href="#icon-hash" /></svg></span>api-v3</p>
              <p class="aws-stream"><span class="aws-tile"><svg><use href="#icon-hash" /></svg></span>product</p>
              <p class="aws-stream is-active"><span class="aws-tile"><svg><use href="#icon-hash" /></svg></span>sprint-planning</p>
            </div>
            <div class="aws-foot"><span class="aws-me">MR</span>Maya Reyes<svg><use href="#icon-chevronup" /></svg></div>
          </div>

          <div class="aw-stream" aria-hidden="true">
            <AppStreamHeader title="#sprint-planning" panelOpen />
            <div class="aw-log">
              <p class="day-divider aw-optional"><span>Thursday, May 7</span></p>
              <Message author="sam" time="09:10" class="aw-optional">
                <div class="tl-text">planning doc is up. auth is first on the list</div>
              </Message>
              <Message author="maya" time="09:12">
                <div class="tl-text"><span class="mention">@ariadne</span> we're picking auth back up this sprint. Why did we hold it?</div>
              </Message>
              <TraceCard subtitle="3 steps • 4.1s" time="09:12" />
              <Message author="ariadne" time="09:12">
                <div class="tl-text">You paused v3 on March 12 until Jordan reviewed the token-rotation model. That walkthrough hasn't happened yet.</div>
                <div class="quote-card">
                  <div class="qm"><svg><use href="#quote-icon" /></svg></div>
                  <div class="q-author">
                    <div class="q-avatar tl-avatar">JL</div>
                    <div class="q-name">Jordan Lee</div>
                    <div class="q-time">Mar 12, 11:42</div>
                  </div>
                  <div class="q-body">hold on, I'm not comfortable changing the auth boundary without working through the token-rotation flow first.</div>
                </div>
                <div class="is-selected">
                  <MemoEmbed type="decision" tag="#api-v3" title="Auth refactor held pending token-rotation review" date="Mar 12" />
                </div>
              </Message>
            </div>
            <div class="aw-composer aw-optional"><AppComposer /></div>
          </div>

          <aside class="aw-panel" aria-hidden="true">
            <div class="aw-panel-head">
              <svg class="aw-panel-icon"><use href="#icon-bookopen" /></svg>
              <span>Auth refactor held pending token-rotation review</span>
              <svg><use href="#icon-x" /></svg>
            </div>
            <div class="aw-memo">
              <p class="aw-badges"><span class="aw-kind"><svg><use href="#icon-compass" /></svg>Decision</span><span class="aw-ver">#api-v3 • Mar 12</span></p>
              <h3>Auth refactor held pending token-rotation review</h3>
              <p class="aw-abstract">Jordan asked to pause the v3 auth boundary until the rotation flow has been walked through. Migrating live sessions would otherwise force everyone to sign in again.</p>
              <p class="aw-memo-label">Key points</p>
              <ul class="aw-points">
                <li>v3 auth changes are on hold</li>
                <li>Jordan walks the team through token rotation first</li>
                <li>Existing sessions must migrate without a forced sign-in</li>
              </ul>
              <p class="aw-memo-label">Source messages</p>
              <div class="aw-source">
                <p class="aw-source-head">Jordan Lee</p>
                <p class="aw-source-body">hold on, I'm not comfortable changing the auth boundary without working through the token-rotation flow first.</p>
              </div>
            </div>
          </aside>
        </figure>
      </div>
    </section>

    <section class="section" id="memory" aria-labelledby="memory-title">
      <div class="wrap split">
        <div class="copy">
          <h2 id="memory-title" class="h2">What Threa keeps.</h2>
          <p class="lede">
            Threa reads each conversation once it goes quiet and keeps the parts
            worth recalling as short memos, each linked to the messages it came
            from. Every message stays searchable either way. A memo puts the
            outcome and its reasons in one place, which is what Ariadne, the
            built-in agent, finds when someone asks.
          </p>
          <dl class="kinds">
            <div><dt>Decisions</dt><dd>A choice the team made, with the reasons.</dd></div>
            <div><dt>Procedures</dt><dd>A setup, fix or process that works.</dd></div>
            <div><dt>Learnings</dt><dd>Something found out by debugging or trying.</dd></div>
            <div><dt>References</dt><dd>A fact pinned down: an id, a value, a place.</dd></div>
            <div><dt>Context</dt><dd>Why something is the way it is.</dd></div>
          </dl>
          <p class="fine">
            A model decides what's worth keeping, and passing status, reactions
            and lunch orders usually produce nothing. You can edit or archive any
            memo. A memo is visible to the people who can open the conversation it
            came from, and automatic memory can be turned off per channel.
          </p>
        </div>
        <figure class="media panel app-ui" aria-label="A conversation in #api-v3 on March 12. Two lunch messages are ignored; the three messages that settle the auth question become a memo, announced in the channel as Saved to memory.">
          <div aria-hidden="true"><AppStreamHeader title="#api-v3" /></div>
          <div class="panel-body" aria-hidden="true">
            <p class="day-divider"><span>Thursday, March 12</span></p>
            <Message author="sam" time="11:38" class="is-noise">
              <div class="tl-text">lunch order, pasta or pizza. last call</div>
            </Message>
            <div class="kept">
              <Message author="jordan" time="11:42">
                <div class="tl-text">hold on, I'm not comfortable changing the auth boundary without working through the token-rotation flow first. can we pause this?</div>
              </Message>
              <Message author="maya" time="11:44">
                <div class="tl-text">Fair. Let's hold v3 until you've walked us through it. What do you need from us?</div>
              </Message>
              <Message author="jordan" time="11:46">
                <div class="tl-text">a walkthrough of the rotation flow + how existing sessions migrate. I'll block out time the week of the 18th</div>
              </Message>
            </div>
            <Message author="sam" time="11:47" class="is-noise">
              <div class="tl-text">pizza it is, ordering now</div>
            </Message>
            <MemoSaved title="Auth refactor held pending token-rotation review" />
          </div>
        </figure>
      </div>
    </section>

    <section class="section" id="board" aria-labelledby="board-title">
      <div class="wrap">
        <div class="split stack-head">
          <div class="copy">
            <h2 id="board-title" class="h2">Every conversation gets a card.</h2>
          </div>
          <div class="media">
            <p class="lede">
              A busy channel holds several discussions at once. Threa groups its
              messages into conversations, each with a title, and the board shows
              them as cards, newest first. Look across every stream you're in or
              filter down to one, and open the discussion instead of scrolling
              for it.
            </p>
            <p class="fine">Grouping is automatic. When it files a message in the wrong place, you can move it, or rename or split the topic.</p>
          </div>
        </div>

        <div class="board-switch" role="group" aria-label="Show #launch as">
          <input type="radio" name="board-view" id="board-view-stream" />
          <label for="board-view-stream">Stream</label>
          <input type="radio" name="board-view" id="board-view-board" checked />
          <label for="board-view-board">Board</label>
        </div>

        <div class="board-compare" aria-label="The #launch channel shown two ways: as a stream in time order, where a launch-date question and a pricing-copy review interleave, and as a board where the same messages sit in two topic cards." role="img">
          <div class="board-col app-ui is-stream" aria-hidden="true">
            <div class="board-lens"><span class="k">Stream</span><span class="m">#launch, as it happened</span></div>
            <Message author="maya" time="14:03">
              <div class="tl-text">Are we still on for the 14th? Press wants a date by Friday.</div>
            </Message>
            <Message author="sam" time="14:04">
              <div class="tl-text">pricing page copy is up for review, comments welcome</div>
              <div class="reactions"><span class="rxn"><span class="em">👀</span><span class="num">2</span></span></div>
            </Message>
            <Message author="alex" time="14:05">
              <div class="tl-text">the embargo note said the 21st, didn't it?</div>
            </Message>
            <Message author="maya" time="14:06">
              <div class="tl-text">right, the 21st. I'll tell press</div>
            </Message>
            <Message author="jordan" time="14:07">
              <div class="tl-text">left two notes on the pricing copy, mostly the annual toggle</div>
            </Message>
            <div class="board-composer"><AppComposer /></div>
          </div>

          <div class="board-col app-ui is-board" aria-hidden="true">
            <div class="board-lens"><span class="k">Board</span><span class="m">filtered to #launch</span></div>
            <div class="board-list">
              <div class="board-card">
                <div class="board-card-title">
                  <svg class="chev"><use href="#icon-chevron" /></svg>
                  <span class="title">Launch date: the 14th or the 21st?</span>
                  <span class="unread-dot"></span>
                  <span class="board-hbtn"><svg><use href="#icon-panelright" /></svg></span>
                </div>
                <div class="board-locator"><span class="board-tile"><svg><use href="#icon-hash" /></svg></span><span class="lstream">launch</span><span>now</span></div>
                <div class="board-card-body">
                  <Message author="maya" time="14:03">
                    <div class="tl-text">Are we still on for the 14th? Press wants a date by Friday.</div>
                  </Message>
                  <Message author="alex" time="14:05">
                    <div class="tl-text">the embargo note said the 21st, didn't it?</div>
                  </Message>
                  <Message author="maya" time="14:06">
                    <div class="tl-text">right, the 21st. I'll tell press</div>
                  </Message>
                </div>
              </div>
              <div class="board-card">
                <div class="board-card-title">
                  <svg class="chev"><use href="#icon-chevron" /></svg>
                  <span class="title">Pricing page copy review</span>
                  <span class="dot-slot"></span>
                  <span class="board-hbtn"><svg><use href="#icon-panelright" /></svg></span>
                </div>
                <div class="board-locator"><span class="board-tile"><svg><use href="#icon-hash" /></svg></span><span class="lstream">launch</span><span>2m</span></div>
                <div class="board-card-body">
                  <Message author="sam" time="14:04">
                    <div class="tl-text">pricing page copy is up for review, comments welcome</div>
                    <div class="reactions"><span class="rxn"><span class="em">👀</span><span class="num">2</span></span></div>
                  </Message>
                  <Message author="jordan" time="14:07">
                    <div class="tl-text">left two notes on the pricing copy, mostly the annual toggle</div>
                  </Message>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="basics" aria-labelledby="basics-title">
      <div class="wrap split">
        <div class="copy">
          <h2 id="basics-title" class="h2">Threads, quotes and code.</h2>
          <p class="lede">
            Threads nest, so a tangent off a tangent gets its own space instead of
            taking over the parent, and a stray reply can be moved into one after
            the fact. Quote replies point at the exact line someone wrote. Code
            keeps its formatting and gets highlighted.
          </p>
          <p class="body">
            The full-screen composer gives a long message room, with no stray
            Enter sending it early.
          </p>
        </div>
        <figure class="media panel app-ui" aria-label="In #web, Sam posts the line of code that prices the annual plan; a thread under it has three replies. Jordan quote-replies to ask whether the page means two months free or 20% off.">
          <div aria-hidden="true"><AppStreamHeader title="#web" /></div>
          <div class="panel-body" aria-hidden="true">
            <Message author="sam" time="10:14">
              <div class="tl-text">this is what the annual toggle does now:</div>
              <div class="code-block">
                <div class="code-head"><svg><use href="#icon-chevron" /></svg>TypeScript<span>2 lines</span><svg class="code-icon"><use href="#icon-copy" /></svg></div>
                <pre tabindex="-1"><code><span class="tk-k">const</span> yearly <span class="tk-o">=</span> monthly <span class="tk-o">*</span> <span class="tk-n">10</span>
<span class="tk-k">return</span> <span class="tk-f">formatPrice</span>(annual <span class="tk-o">?</span> yearly : monthly)</code></pre>
              </div>
              <div class="thread-card">
                <div class="thread-top"><span class="thread-avs"><span class="tl-avatar">JL</span><span class="tl-avatar">MR</span></span><span class="thread-count">3 replies</span><span class="thread-dot">·</span><span class="thread-when">2m</span><svg><use href="#icon-chevronright" /></svg></div>
                <p class="thread-last"><span>Maya Reyes</span>: two months free, that's what we agreed</p>
              </div>
            </Message>
            <Message author="jordan" time="10:21">
              <div class="quote-card">
                <div class="qm"><svg><use href="#quote-icon" /></svg></div>
                <div class="q-author"><div class="q-avatar tl-avatar">SP</div><div class="q-name">Sam Patel</div></div>
                <div class="q-body">this is what the annual toggle does now</div>
              </div>
              <div class="tl-text">the page copy says 20% off. <code>* 10</code> is closer to 17%</div>
            </Message>
          </div>
        </figure>
      </div>
    </section>

    <section class="section section-band" id="agents" aria-labelledby="agents-title">
      <div class="wrap">
        <div class="split stack-head">
          <div class="copy">
            <h2 id="agents-title" class="h2">Bring the agent you already use.</h2>
          </div>
          <div class="media">
            <p class="lede">
              Threa ships with Ariadne. If you already have an agent set up with
              your codebase and context, connect it as a Threa bot instead of
              starting over. It can stay on your laptop, behind NAT.
            </p>
            <p class="body">
              Mention it and your agent picks up the request. It searches
              messages, reads memos and attachments, and works while you watch.
              It reads public channels, posts only where it has been added, and
              can't see a private channel until you add it.
            </p>
          </div>
        </div>

        <div class="agent-stage">
          <figure class="agent-demo">
          <div class="ad app-ui" role="img" aria-label="Alex asks the Claude Code bot in #api-v3 whether token rotation still signs out old sessions. The bot searches messages, reads the March 12 memo and the rotation code, pushes a fix, and replies linking the memo.">
            <div class="ad-head" aria-hidden="true">
              <AppStreamHeader title="#api-v3">
                <span class="ad-chip">
                  <svg><use href="#spinner-icon" /></svg>
                  <span>Claude Code</span>
                  <span class="ad-chip-steps">• <span class="ad-steps">1 step</span></span>
                </span>
              </AppStreamHeader>
            </div>
            <div class="ad-log" aria-hidden="true">
              <Message author="maya" time="13:30" ago={37}>
                <div class="tl-text">cutover is this afternoon. I'll drive it, Jordan is on call</div>
              </Message>
              <Message author="jordan" time="13:35" ago={32}>
                <div class="tl-text">v3 is on staging. Webhooks, cursor pagination and the new error shapes are all in.</div>
              </Message>
              <Message author="sam" time="13:41" ago={26}>
                <div class="tl-text">staging database migrated cleanly, took four minutes</div>
              </Message>
              <Message author="jordan" time="13:46" ago={21}>
                <div class="tl-text">SDK tests pass against it. Two flaky ones on retries, both old.</div>
              </Message>
              <Message author="alex" time="13:52" ago={15}>
                <div class="tl-text">release notes draft is in the doc. I'll send the v2 deprecation notice once we flip it</div>
              </Message>
              <Message author="maya" time="14:01" ago={6}>
                <div class="tl-text">Before we ship: does token rotation still sign out sessions issued before the migration?</div>
              </Message>
              <div class="ad-in" data-beat="sent"><div>
                <Message author="alex" time="14:07" ago={0}>
                  <div class="tl-text"><span class="mention is-bot">@claude-code</span> can you check?</div>
                </Message>
              </div></div>
              <div class="ad-in" data-beat="working"><div>
                <div class="trace-card ad-trace">
                  <div class="trace-icon-slot">
                    <div class="trace-icon trace-icon-running"><svg><use href="#spinner-icon" /></svg></div>
                    <div class="trace-icon trace-icon-done"><svg><use href="#check-icon" /></svg></div>
                  </div>
                  <div class="trace-main">
                    <div class="trace-title ad-trace-title">Claude Code is working…</div>
                    <div class="trace-sub ad-trace-sub">
                      <span class="ad-pulse"></span>
                      <span class="ad-substep">Searching messages for “token rotation”</span>
                      <span class="ad-trace-count">• <span class="ad-steps">1 step</span></span>
                    </div>
                  </div>
                  <div class="trace-time" data-ago="0">14:07</div>
                  <div class="ad-actions">
                    <span class="ad-action"><svg><use href="#icon-msgplus" /></svg><span>Redirect</span></span>
                    <span class="ad-action"><svg><use href="#icon-stopcircle" /></svg><span>Stop</span></span>
                  </div>
                </div>
              </div></div>
              <div class="ad-in" data-beat="replied"><div>
                <Message author="claude-code" time="14:07" ago={0}>
                  <div class="tl-text">Yes. Sessions from before the migration keep their old refresh token, so the first rotation signs them out. It's the case Jordan wanted walked through when v3 was held:</div>
                  <MemoEmbed type="decision" tag="#api-v3" title="Auth refactor held pending token-rotation review" date="Mar 12" />
                  <div class="tl-text ad-after">I pushed a fix to <code>auth-rotation</code> that migrates them on first refresh.</div>
                  <div class="reactions">
                    <span class="rxn" data-rxn="pray"><span class="em">🙏</span><span class="num"><span>1</span><span>2</span></span></span>
                    <span class="rxn" data-rxn="eyes"><span class="em">👀</span><span class="num"><span>1</span></span></span>
                  </div>
                </Message>
              </div></div>
            </div>
            <div class="ad-composer" aria-hidden="true">
              <AppComposer>
                <span class="composer-mention-wrap"><span class="mention is-bot">@claude-code</span></span>
                <span class="composer-typed" data-trail=" can you check?"></span>
                <span class="composer-caret"></span>
              </AppComposer>
            </div>
          </div>
          </figure>

          <figure class="trace-panel app-ui" aria-label="The same session opened as a trace">
            <div class="tp-head" aria-hidden="true">
              <div>
                <p class="tp-title">Agent Session Trace</p>
                <p class="tp-meta">Claude Code • <span data-ago="0">14:07</span><span class="tp-duration"> • 34s</span></p>
              </div>
              <svg><use href="#icon-x" /></svg>
            </div>
            <details class="tp-details" open>
            <summary class="tp-summary"><span>Show all five steps</span><svg aria-hidden="true"><use href="#icon-chevron" /></svg></summary>
            <ol class="tp-steps">
              <li class="tp-step" style="--hue: 270 60% 50%">
                <div class="tp-step-head"><span class="tp-chip"><svg><use href="#icon-building" /></svg>Workspace Search</span><span class="tp-time">3s</span></div>
                <p>Searched messages for “token rotation”. Three matches in #api-v3, the closest from March 12.</p>
              </li>
              <li class="tp-step" style="--hue: 200 70% 50%">
                <div class="tp-step-head"><span class="tp-chip"><svg><use href="#icon-wrench" /></svg>Tool Call</span><span class="tp-time">2s</span></div>
                <p>Read memo “Auth refactor held pending token-rotation review” and its three source messages.</p>
              </li>
              <li class="tp-step" style="--hue: 200 70% 50%">
                <div class="tp-step-head"><span class="tp-chip"><svg><use href="#icon-wrench" /></svg>Tool Call</span><span class="tp-time">11s</span></div>
                <p>Read <code>src/auth/rotation.ts</code>. Refresh tokens issued before the migration fail the new signature check.</p>
              </li>
              <li class="tp-step" style="--hue: 200 70% 50%">
                <div class="tp-step-head"><span class="tp-chip"><svg><use href="#icon-wrench" /></svg>Tool Call</span><span class="tp-time">16s</span></div>
                <p>Pushed a fix to <code>auth-rotation</code> that migrates old tokens on their first refresh.</p>
              </li>
              <li class="tp-step" style="--hue: 142 76% 36%">
                <div class="tp-step-head"><span class="tp-chip"><svg><use href="#icon-message" /></svg>Response</span><span class="tp-time">2s</span></div>
                <p>Replied in #api-v3, linking the March 12 memo.</p>
              </li>
            </ol>
            </details>
          </figure>
        </div>
        <div class="split agent-more">
          <div class="copy">
            <p class="caption">The session as it plays out in the channel, and the trace its card opens: each search, each source it read and what it changed.</p>
          </div>
          <div class="media">
            <p class="fine">Works with Claude Code, Codex, Cursor, OpenCode, Gemini CLI, or a bot you write, through the bot runtime, the CLI or the MCP server.</p>
            <a class="text-link" href="/developers/recipes#local-agent">Connect a local agent</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="privacy" aria-labelledby="privacy-title">
      <div class="wrap split">
        <div class="copy">
          <h2 id="privacy-title" class="h2">Some work stays between you and your agent.</h2>
          <p class="lede">
            A scratchpad is a conversation that belongs to you alone, for notes
            and for working with Ariadne or your own agent. That work means
            pasting commands, diffs and output you wouldn't paste into a group
            chat. Seal a scratchpad and all of it is encrypted on your devices,
            including its name. Threa's servers hold the ciphertext and have no
            way to open it.
          </p>
          <p class="body">
            Not everything private needs sealing. An aside is a side chat with
            Ariadne next to a channel conversation. It isn't encrypted, but only
            you see it, and nothing in it reaches the channel until you send it
            yourself.
          </p>
          <a class="text-link" href="/encryption">How sealed scratchpads work</a>
        </div>
        <figure class="media panel app-ui" aria-label="A sealed scratchpad called Deploy notes, shared only with Claude Code. Maya pastes a failing deploy log; Claude Code explains that the preview environment is missing a secret.">
          <div aria-hidden="true">
            <AppStreamHeader title="Deploy notes">
              <span class="app-pill app-pill-icon"><svg><use href="#icon-lock" /></svg></span>
              <span class="app-pill"><svg><use href="#icon-bot" /></svg>Claude Code</span>
            </AppStreamHeader>
            <div class="panel-body">
              <Message author="maya" time="16:40">
                <div class="tl-text">the preview deploy fails and I can't see why. full log:</div>
                <div class="code-block">
                  <div class="code-head"><svg><use href="#icon-chevron" /></svg>Log<span>3 lines</span><svg class="code-icon"><use href="#icon-copy" /></svg></div>
                  <pre tabindex="-1"><code><span class="tk-del">error: STRIPE_WEBHOOK_SECRET is not set</span>
<span class="tk-o">    at loadConfig (src/config.ts:41)</span>
<span class="tk-o">exit code 1</span></code></pre>
                </div>
              </Message>
              <Message author="claude-code" time="16:41">
                <div class="tl-text">That secret is only set for production. Add it to the preview environment and re-run the deploy. Nothing in the code needs to change.</div>
              </Message>
            </div>
          </div>
        </figure>
      </div>
      <div class="wrap privacy-table">
        <table class="reads">
            <caption>What Threa can read</caption>
            <thead>
              <tr><th scope="col">Where</th><th scope="col">Searchable and remembered</th><th scope="col">Who can read it</th></tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row">Channels, DMs, threads</th>
                <td data-label="Searchable and remembered">Yes. That's how search and memory work.</td>
                <td data-label="Who can read it">Members, and Threa. Encrypted in transit and at rest.</td>
              </tr>
              <tr>
                <th scope="row"><svg aria-hidden="true"><use href="#icon-lock" /></svg>Sealed scratchpads</th>
                <td data-label="Searchable and remembered">No. Nothing in one becomes a memo.</td>
                <td data-label="Who can read it">You and the agents you let in. Not Threa.</td>
              </tr>
            </tbody>
          </table>
          <p class="fine">Lose the passphrase and sealed content is gone. There's no reset, because a reset would mean someone else had the key.</p>
      </div>
    </section>

    <section class="section section-compact" id="open-source" aria-labelledby="os-title">
      <div class="wrap split is-flipped">
        <div class="copy">
          <h2 id="os-title" class="h2">It's open source.</h2>
          <p class="lede">
            The frontend, backend, control plane and infrastructure are public,
            and the public repo is the one we deploy. Read how Threa works, fork
            it, or run it yourself. MIT licensed, so do whatever. I won't take it
            personally. The design docs are public too, and so are the
            <a href="/developers/feature-requests">feature requests</a>.
          </p>
        </div>
        <div class="media os-media">
          <div class="os-terminal" aria-hidden="true" tabindex="-1">
            <span class="row"><span class="prompt">$</span><span class="cmd">git clone</span> <span class="arg">https://github.com/threahq/threa.git</span></span>
            <span class="row"><span class="prompt">$</span><span class="cmd">cd</span> <span class="arg">threa</span> <span class="cmd">&amp;&amp;</span> <span class="cmd">bun install</span></span>
            <span class="row"><span class="prompt">$</span><span class="cmd">bun run dev</span></span>
            <span class="row out">Starting PostgreSQL...</span>
            <span class="row out">Starting MinIO...</span>
            <span class="row out">PostgreSQL is ready</span>
            <span class="row out">MinIO is ready</span>
          </div>
          <a class="text-link" href="https://github.com/threahq/threa">Browse the source on GitHub</a>
        </div>
      </div>
    </section>

    {/* The app is on another origin, so beforeinstallprompt never fires here. */}
    <section class="section section-compact" id="install" aria-labelledby="install-title">
      <div class="wrap split install-shell">
        <div class="copy install-copy">
          <h2 id="install-title" class="h2">Install it on any device.</h2>
          <p class="lede">
            There's no App Store or Play Store version. Threa is a web app you
            install from your browser: it gets its own icon and window, opens
            without a connection, and sends what you wrote once you're back. On
            iPhone and iPad, installing is also what turns on notifications.
          </p>
          <div class="install-tabs" role="radiogroup" aria-label="Your device">
            {installTabs.map(({ platform, label }, i) => (
              <>
                <input class="install-radio" type="radio" name="install-platform" id={`install-${platform}`} value={platform} checked={i === 0} />
                <label for={`install-${platform}`}>{label}</label>
              </>
            ))}
          </div>
        </div>
        <div class="media install-panels">
          <section class="install-panel" data-platform="ios">
            <h3>iPhone and iPad</h3>
            <ol class="install-steps">
              <li>Open <a href={apiBase}>{appHost}</a> in Safari.</li>
              <li>Tap <span class="ui">Share</span> <span class="glyph" aria-hidden="true"><svg><use href="#icon-share" /></svg></span>. If you don't see it, tap <span class="glyph"><svg aria-hidden="true"><use href="#icon-morehoriz" /></svg><span class="sr">More</span></span> first.</li>
              <li>Tap <span class="ui">Add to Home Screen</span>. You may need to scroll down or tap <span class="ui">View More</span> to find it.</li>
              <li>If you see <span class="ui">Open as Web App</span>, leave it on. Tap <span class="ui">Add</span>.</li>
              <li>Open Threa from your Home Screen and sign in. For notifications, go to <span class="ui">Settings → Notifications</span> and turn on <span class="ui">Push on this device</span>.</li>
            </ol>
            <p class="install-note">Notifications need iOS 16.4 or later and only work in the app on your Home Screen, not in a Safari tab. Chrome and Edge on iPhone have <span class="ui">Add to Home Screen</span> in their Share menu too.</p>
          </section>
          <section class="install-panel" data-platform="android">
            <h3>Android</h3>
            <ol class="install-steps">
              <li>Open <a href={apiBase}>{appHost}</a> in Chrome.</li>
              <li>Tap the menu <span class="glyph"><svg aria-hidden="true"><use href="#icon-morevert" /></svg><span class="sr">⋮</span></span> next to the address bar.</li>
              <li>Tap <span class="ui">Add to home screen</span> or <span class="ui">Install app</span>, whichever your menu shows, then tap <span class="ui">Install</span>.</li>
              <li>Open Threa from your home screen or app list.</li>
            </ol>
            <p class="install-note">Once it's installed, Threa shows up in Android's share sheet, so you can send it a photo, link or file from another app. Samsung Internet, Edge and Firefox have an install option in their menus too.</p>
          </section>
          <section class="install-panel" data-platform="chromium">
            <h3>Chrome or Edge on a computer</h3>
            <ol class="install-steps">
              <li>Open <a href={apiBase}>{appHost}</a>.</li>
              <li>Click <span class="ui">Install</span> <span class="glyph" aria-hidden="true"><svg><use href="#icon-install" /></svg></span> at the right end of the address bar. In Edge it's labeled <span class="ui">App available</span>.</li>
              <li>Click <span class="ui">Install</span>.</li>
            </ol>
            <p class="install-note">No icon in the address bar? In Chrome, open the menu <span class="glyph"><svg aria-hidden="true"><use href="#icon-morevert" /></svg><span class="sr">⋮</span></span> and choose <span class="ui">Cast, save, and share → Install Threa</span>. In Edge, open <span class="glyph"><svg aria-hidden="true"><use href="#icon-morehoriz" /></svg><span class="sr">···</span></span> and choose <span class="ui">Apps → Install Threa</span>.</p>
          </section>
          <section class="install-panel" data-platform="mac-safari">
            <h3>Safari on a Mac</h3>
            <ol class="install-steps">
              <li>Open <a href={apiBase}>{appHost}</a> in Safari.</li>
              <li>Choose <span class="ui">File → Add to Dock</span>, or click <span class="ui">Share</span> <span class="glyph" aria-hidden="true"><svg><use href="#icon-share" /></svg></span> and choose <span class="ui">Add to Dock</span>.</li>
              <li>Click <span class="ui">Add</span>.</li>
            </ol>
            <p class="install-note">Needs macOS Sonoma (14) or later. On older versions, install it from Chrome or Edge instead.</p>
          </section>
          <section class="install-panel" data-platform="firefox">
            <h3>Firefox</h3>
            <ol class="install-steps">
              <li>On Windows, open <a href={apiBase}>{appHost}</a> in Firefox.</li>
              <li>Click <span class="ui">Add to taskbar</span> <span class="glyph" aria-hidden="true"><svg><use href="#icon-install" /></svg></span> at the right end of the address bar.</li>
              <li>Threa opens in its own window and stays pinned to your taskbar.</li>
            </ol>
            <p class="install-note">Firefox on Mac and Linux, and the Microsoft Store version of Firefox, can't install web apps. Threa works in a regular Firefox tab there. For a separate window with its own icon, use Chrome, Edge or Safari.</p>
          </section>
        </div>
      </div>
    </section>
