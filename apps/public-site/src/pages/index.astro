  <script is:inline>
  /* The agent-section demo. Plays once, from when it scrolls into view, so
     visitors see the agent work instead of its end state. Reduced motion shows
     the finished conversation. */
  (function () {
    const ad = document.querySelector('.byo-demo .ad')
    if (!ad) return
    const $ = (s) => ad.querySelector(s)

    const now = Date.now()
    const pad = (n) => String(n).padStart(2, '0')
    ad.querySelectorAll('[data-ago]').forEach((el) => {
      const d = new Date(now - Number(el.dataset.ago) * 60_000)
      el.textContent = `${pad(d.getHours())}:${pad(d.getMinutes())}`
    })

    const beat = (name) => ad.querySelector(`[data-beat="${name}"]`).classList.add('is-in')
    const steps = (n) => ad.querySelectorAll('.ad-steps').forEach((el) => { el.textContent = `${n} step${n === 1 ? '' : 's'}` })
    const substep = (text) => {
      const el = $('.ad-substep')
      el.textContent = text
      el.classList.remove('tick'); void el.offsetWidth; el.classList.add('tick')
    }
    const react = (name, count) => {
      const el = ad.querySelector(`[data-rxn="${name}"]`)
      el.classList.add('is-in')
      el.style.setProperty('--n', String(count - 1))
    }
    const finish = () => {
      ad.classList.remove('is-working')
      ad.classList.add('is-done')
      $('.ad-trace-title').textContent = 'Session complete'
      $('.ad-trace-sub').textContent = '4 steps • 34s'
    }

    const typed = $('.composer-typed')
    const trail = Array.from(typed.dataset.trail)
    let typing = 0
    const typeTrail = (i = 0) => {
      typed.textContent = trail.slice(0, i).join('')
      if (i < trail.length) typing = setTimeout(() => typeTrail(i + 1), 70 + Math.random() * 60)
    }

    const script = [
      [600, () => ad.classList.add('is-drafting')],
      [1300, () => ad.classList.add('has-mention')],
      [1700, () => typeTrail()],
      [3500, () => {
        clearTimeout(typing)
        ad.classList.remove('is-drafting', 'has-mention')
        typed.textContent = ''
        beat('sent')
      }],
      [4300, () => { ad.classList.add('is-working'); beat('working') }],
      [5600, () => { steps(2); substep('Reading memo “Auth refactor held pending token-rotation review”') }],
      [7200, () => { steps(3); substep('Reading src/auth/rotation.ts') }],
      [9400, () => { steps(4); substep('Pushing a fix to auth-rotation') }],
      [11200, () => { finish(); beat('replied') }],
      [13200, () => react('pray', 1)],
      [14300, () => react('eyes', 1)],
      [15100, () => react('pray', 2)],
    ]

    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      ad.classList.add('is-static')
      ad.querySelectorAll('[data-beat]').forEach((el) => el.classList.add('is-in'))
      finish()
      react('pray', 2)
      react('eyes', 1)
      return
    }

    const io = new IntersectionObserver((entries) => {
      if (!entries.some((e) => e.isIntersecting)) return
      io.disconnect()
      script.forEach(([at, fn]) => setTimeout(fn, at))
    }, { threshold: 0.4 })
    io.observe(ad)
  })()
  </script>


  <script is:inline define:vars={{ apiBase }}>
  /* Waitlist signup. Validates on the client for fast feedback, then POSTs to
     the control-plane (via the workspace-router). The server validates
     authoritatively and dedupes; a repeat email still resolves as success. */
  (function () {
    const form = document.getElementById("waitlist-form")
    if (!form) return
    const email = document.getElementById("wl-email")
    const hp = document.getElementById("wl-hp")
    const submit = document.getElementById("wl-submit")
    const status = document.getElementById("wl-status")
    const idle = "No spam. One email when your invite is ready."

    const setStatus = (msg, kind) => {
      status.textContent = msg
      status.classList.remove("is-ok", "is-err")
      if (kind) status.classList.add(kind)
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault()
      const value = (email.value || "").trim()
      if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(value)) {
        setStatus("Enter a valid email address.", "is-err")
        email.focus()
        return
      }

      const original = submit.textContent
      submit.disabled = true
      submit.textContent = "Joining…"
      setStatus(idle)

      try {
        const res = await fetch(apiBase + "/api/waitlist", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email: value, source: "home", hp: hp.value || "" }),
        })
        if (!res.ok) throw new Error("status " + res.status)
        form.reset()
        submit.textContent = "Joined"
        setStatus("You're on the list.", "is-ok")
      } catch {
        submit.disabled = false
        submit.textContent = original
        setStatus("Something went wrong. Try again.", "is-err")
      }
    })
  })()
  </script>
