  <script is:inline>
  /* The agent demo plays once, from when it scrolls into view, so visitors see
     the agent work instead of its end state. Reduced motion shows the finished
     conversation. */
  (function () {
    const ad = document.querySelector('.agent-demo .ad')
    if (!ad) return
    const $ = (s) => ad.querySelector(s)
    const panel = document.querySelector('.trace-panel')
    const traceSteps = panel.querySelectorAll('.tp-step')
    const details = panel.querySelector('.tp-details')
    const summary = details.querySelector('summary span')
    const phone = matchMedia('(max-width: 880px)')
    details.open = !phone.matches
    phone.addEventListener('change', () => { details.open = !phone.matches })
    details.addEventListener('toggle', () => {
      summary.textContent = details.open ? 'Hide the steps' : 'Show all five steps'
    })
    const now = Date.now()
    const pad = (n) => String(n).padStart(2, '0')
    ad.closest('.agent-stage').querySelectorAll('[data-ago]').forEach((el) => {
      const d = new Date(now - Number(el.dataset.ago) * 60_000)
      el.textContent = `${pad(d.getHours())}:${pad(d.getMinutes())}`
    })
    const beat = (name) => ad.querySelector(`[data-beat="${name}"]`).classList.add('is-in')
    const steps = (n) => {
      ad.querySelectorAll('.ad-steps').forEach((el) => { el.textContent = `${n} step${n === 1 ? '' : 's'}` })
      traceSteps.forEach((el, i) => el.classList.toggle('is-in', i < n))
    }
    const substep = (text) => {
      const el = $('.ad-substep')
      el.textContent = text
      el.classList.remove('tick'); void el.offsetWidth; el.classList.add('tick')
    }
    const react = (name, count) => {
      const el = ad.querySelector(`[data-rxn="${name}"]`)
      el.classList.add('is-in')
      el.style.setProperty('--n', String(count - 1))
    }
    const finish = () => {
      ad.classList.remove('is-working')
      ad.classList.add('is-done')
      $('.ad-trace-title').textContent = 'Session complete'
      $('.ad-trace-sub').textContent = '5 steps • 34s'
      steps(traceSteps.length)
      panel.querySelector('.tp-duration').textContent = ' • 34s'
    }
    const typed = $('.composer-typed')
    const trail = Array.from(typed.dataset.trail)
    let typing = 0
    const typeTrail = (i = 0) => {
      typed.textContent = trail.slice(0, i).join('')
      if (i < trail.length) typing = setTimeout(() => typeTrail(i + 1), 70 + Math.random() * 60)
    }
    const script = [
      [300, () => ad.classList.add('is-drafting')],
      [800, () => ad.classList.add('has-mention')],
      [1100, () => typeTrail()],
      [2700, () => {
        clearTimeout(typing)
        ad.classList.remove('is-drafting', 'has-mention')
        typed.textContent = ''
        beat('sent')
      }],
      [3200, () => { ad.classList.add('is-working'); beat('working'); steps(1); panel.querySelector('.tp-duration').textContent = ' • running' }],
      [4500, () => { steps(2); substep('Reading memo “Auth refactor held pending token-rotation review”') }],
      [6100, () => { steps(3); substep('Reading src/auth/rotation.ts') }],
      [8300, () => { steps(4); substep('Pushing a fix to auth-rotation') }],
      [10100, () => { finish(); beat('replied') }],
      [12100, () => react('pray', 1)],
      [13200, () => react('eyes', 1)],
      [14000, () => react('pray', 2)],
    ]
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      ad.classList.add('is-static')
      ad.querySelectorAll('[data-beat]').forEach((el) => el.classList.add('is-in'))
      finish()
      react('pray', 2)
      react('eyes', 1)
      return
    }
    panel.classList.add('is-live')
    panel.querySelector('.tp-duration').textContent = ''
    const io = new IntersectionObserver((entries) => {
      if (!entries.some((e) => e.isIntersecting)) return
      io.disconnect()
      script.forEach(([at, fn]) => setTimeout(fn, at))
    }, { threshold: 0.4 })
    io.observe(ad)
  })()
  </script>
