  -d '{
    "query": "rotation flow",
    "semantic": true,
    "type": ["channel", "thread"],
    "limit": 10
  }'`}
        run={{
          method: "POST",
          path: "{{baseUrl}}/api/v1/workspaces/{{workspaceId}}/messages/search",
