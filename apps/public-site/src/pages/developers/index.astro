---
import DocsLayout from "../../layouts/DocsLayout.astro"
import CodeBlock from "../../components/CodeBlock.astro"
import DocRow from "../../components/DocRow.astro"
import Message from "../../components/Message.astro"
import StreamPreview from "../../components/StreamPreview.astro"
import OutcomePreview from "../../components/OutcomePreview.astro"

const outcomes = [
  {
    id: "agent",
    icon: "icon-bot",
    title: "Your agent answers when it's mentioned",
    note: "Two commands turn a local command into a bot. It pulls work, so no inbound ports.",
    href: "/developers/recipes#local-agent",
  },
  {
    id: "deploy",
    icon: "icon-hash",
    title: "Deploys post to #deploys",
    note: "One POST from CI. A stable clientMessageId stops double posts on retry.",
    href: "/developers/recipes#ci-notify",
  },
  {
    id: "alert",
    icon: "icon-swap",
    title: "Alerts from tools you already run",
    note: "Paste a webhook URL into Grafana or PostHog. No API key.",
    href: "/developers/incoming-webhooks",
  },
  {
    id: "memo",
    icon: "icon-bookopen",
    title: "What was decided, with the messages behind it",
    note: "Search memos, then pull the exact source messages.",
    href: "/developers/recipes#decisions",
  },
  {
    id: "search",
    icon: "icon-search",
    title: "Workspace search in your own tool",
    note: "Semantic or exact, filtered by stream, type, author and date.",
    href: "/developers/recipes#mirror-search",
  },
  {
    id: "delegation",
    icon: "icon-layers",
    title: "Work Threa hands to your machine",
    note: "Claim a delegation card, report progress, post the result.",
    href: "/developers/recipes#delegations",
  },
  {
    id: "sealed",
    icon: "icon-lock",
    title: "An agent in an encrypted scratchpad",
    note: "The server stores ciphertext only. The CLI does the crypto.",
    href: "/developers/recipes#sealed-agent",
  },
] as const
---

<DocsLayout
  title="Overview · Threa Developers"
  description="The Threa public REST API: what it covers, the base URL, and a quickstart that goes from creating an API key to your first memo search."
  current="overview"
>
  <DocRow class="dr-intro">
    <h1>Your workspace, over HTTP.</h1>
    <p class="lead">
      Messages, streams, members, attachments, and the memos Threa builds from
      your conversations. Your own agent reads the same memory Ariadne does.
    </p>

    <StreamPreview stream="platform" slot="code">
      <Message author="maya" time="14:02">
        <div class="tl-text"><span class="mention">@my-agent</span> why did we pause the auth refactor?</div>
      </Message>
      <Message author="my-agent" time="14:02">
        <div class="tl-text">It's on hold until Jordan's review of the token-rotation model.</div>
        <div class="recall-memo-card">
          <div class="rmc-icon"><svg><use href="#icon-compass" /></svg></div>
          <div class="rmc-body">
            <div class="rmc-kicker"><span class="k-type">decision</span><span class="k-tag">#product</span></div>
            <div class="rmc-title">Auth refactor held pending token-rotation review</div>
          </div>
          <div class="rmc-meta">Mar 12</div>
        </div>
      </Message>
    </StreamPreview>
  </DocRow>

  <h2 id="quickstart">Quickstart</h2>
  <p>
    The <a class="link" href="/developers/quickstart">guided quickstart</a>
    makes the same calls from your own terminal.
  </p>
  <ol class="steps">
    <DocRow as="li">
      <h3 id="create-an-api-key">Create an API key</h3>
      <p>
        In the app, open <strong>Workspace Settings → API Keys</strong>, create a
        user key, pick the scopes you need, and copy it once. Full walkthrough in
        <a class="link" href="/developers/authentication">Authentication</a>.
      </p>
    </DocRow>
    <DocRow as="li">
      <h3 id="add-it-to-credentials">Add it to Credentials</h3>
      <p>
        Open <strong>Credentials</strong> (top right) and enter your workspace ID
        and key. Every sample on these pages then uses your values, and
        <strong>Run</strong> calls the API. They stay in your browser. The key goes out
        only on requests you run and on a <code>GET /me</code> that checks it
        when you enter it or open a page.
      </p>
    </DocRow>
    <DocRow as="li">
      <h3 id="confirm-who-you-are">Confirm who you are</h3>
      <p><code>GET /me</code> needs no scope and returns the identity behind the key.</p>
      <CodeBlock
        slot="code"
        lang="bash"
        label="Who am I"
        code={`curl {{baseUrl}}/api/v1/workspaces/{{workspaceId}}/me \\
  -H "Authorization: Bearer {{apiKey}}"`}
        run={{ method: "GET", path: "{{baseUrl}}/api/v1/workspaces/{{workspaceId}}/me" }}
      />
    </DocRow>
    <DocRow as="li">
      <h3 id="search-what-threa-remembers">Search what Threa remembers</h3>
      <p>
        With <code>memos:read</code>, search memos the way Ariadne does. Results
        link back to their source messages.
      </p>
      <CodeBlock
        slot="code"
        lang="bash"
        label="Search memos"
        code={`curl -X POST {{baseUrl}}/api/v1/workspaces/{{workspaceId}}/memos/search \\
  -H "Authorization: Bearer {{apiKey}}" \\
  -H "Content-Type: application/json" \\
  -d '{ "query": "auth", "limit": 5 }'`}
        run={{
          method: "POST",
          path: "{{baseUrl}}/api/v1/workspaces/{{workspaceId}}/memos/search",
          body: `{ "query": "auth", "limit": 5 }`,
        }}
      />
    </DocRow>
  </ol>

  <h2 id="base-url">Base URL</h2>
  <dl class="facts">
    <dt>API</dt>
    <dd><code>https://app.threa.io/api/v1</code></dd>
    <dt>Workspace routes</dt>
    <dd><code>/workspaces/&#123;workspaceId&#125;/…</code></dd>
    <dt>Workspace ID</dt>
    <dd>In the app URL, after <code>/w/</code></dd>
  </dl>

  <h2 id="working-with-an-ai-agent">Working with an AI agent</h2>
  <DocRow>
    <p>
      Every page has a markdown mirror at its URL plus <code>.md</code>.
      <a class="link" href="/llms-full.txt">/llms-full.txt</a> is the whole set in
      one fetch, and the <a class="link" href="/openapi.json">OpenAPI spec</a> is
      the contract. Hand your agent this:
    </p>
    <CodeBlock
      slot="code"
      lang="text"
      label="Prompt for your agent"
      code={`Integrate with the Threa API. Read https://threa.io/llms-full.txt for the docs
and https://threa.io/openapi.json for the exact contract. The base URL is
{{baseUrl}}, my workspace ID is {{workspaceId}}, and my API key is in the
THREA_API_KEY environment variable (send it as "Authorization: Bearer ...").
Verify the key with GET /api/v1/workspaces/{{workspaceId}}/me before anything else.`}
    />
  </DocRow>
  <p>
    Keep the key in an environment variable, not in the prompt. Agents that
    speak MCP can use <code>threa mcp serve</code> instead; see
    <a class="link" href="/developers/cli">CLI &amp; MCP server</a>.
  </p>

  <section class="outcomes" aria-labelledby="what-you-can-build">
    <h2 id="what-you-can-build">What you can build</h2>
    <ol class="ot">
      {outcomes.map((o, i) => (
        <li class="ot-item" style={`--row: ${i + 1}`}>
          <a class="ot-node" href={o.href} tabindex="-1" data-decorative aria-hidden="true"><svg><use href={`#${o.icon}`} /></svg></a>
          <div class="ot-text">
            <h3 id={`build-${o.id}`}><a href={o.href}>{o.title}</a></h3>
            <p>{o.note}</p>
          </div>
          <OutcomePreview id={o.id} />
        </li>
      ))}
    </ol>
    <p>
      Also in the API: attachment uploads with the text Threa extracts, labels,
      conversations and stream membership. All of it is in the
      <a class="link" href="/developers/reference">API reference</a>.
    </p>
  </section>
</DocsLayout>
