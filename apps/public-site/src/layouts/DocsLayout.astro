---
import "../styles/global.css"
import "../styles/docs.css"
import BaseHead from "../components/BaseHead.astro"
import SvgDefs from "../components/SvgDefs.astro"
import ThemeToggle from "../components/ThemeToggle.astro"
import { SIDE_WIDTH } from "../lib/docs-side-width"
import { guideNav } from "../lib/user-guide"

type NavGroup = { group: string; items: { slug: string; label: string; href: string }[] }

interface Props {
  /** Which docs area the page belongs to: its nav, search index and chrome. */
  area?: "developers" | "guide"
  title?: string
  description?: string
  current?: string
  sections?: { id: string; label: string; group?: string }[]
  /** Prose beside a code pane from 1200px (rows are components/DocRow.astro). */
  split?: boolean
}
const { area = "developers", current = "", sections = [], split = false } = Astro.props

const developersNav: NavGroup[] = [
  {
    group: "Get started",
    items: [
      { slug: "overview", label: "Overview", href: "/developers" },
      { slug: "quickstart", label: "Quickstart", href: "/developers/quickstart" },
      { slug: "authentication", label: "Authentication", href: "/developers/authentication" },
    ],
  },
  {
    group: "Reference",
    items: [
      { slug: "reference", label: "API reference", href: "/developers/reference" },
      { slug: "markdown", label: "Markdown", href: "/developers/markdown" },
      { slug: "versioning", label: "Versioning", href: "/developers/versioning" },
      { slug: "operations", label: "Operations", href: "/developers/operations" },
    ],
  },
  {
    group: "Guides",
    items: [
      { slug: "cli", label: "CLI & MCP server", href: "/developers/cli" },
      { slug: "incoming-webhooks", label: "Incoming webhooks", href: "/developers/incoming-webhooks" },
      { slug: "recipes", label: "Recipes", href: "/developers/recipes" },
    ],
  },
  {
    group: "Community",
    items: [{ slug: "feature-requests", label: "Feature requests", href: "/developers/feature-requests" }],
  },
]

const AREAS = {
  developers: {
    name: "Developers",
    home: "/developers",
    nav: developersNav,
    title: "Threa Developers",
    description:
      "Build on Threa: a public REST API over your workspace covering messages, streams, memos, search, and a bot runtime for connecting your own agent.",
    searchLabel: "Search docs",
    searchIndex: "/developers/search-index.json",
    headerLinks: [
      { href: "/guide", label: "Guide" },
      { href: "/developers/reference", label: "Reference" },
      { href: "/developers/recipes", label: "Recipes" },
      { href: "/openapi.json", label: "OpenAPI" },
      { href: "/llms.txt", label: "llms.txt" },
    ],
    sideFoot: [
      { href: "/guide", label: "User guide" },
      { href: "/openapi.json", label: "OpenAPI spec" },
      { href: "/llms.txt", label: "llms.txt" },
    ],
    footBrand: "Threa developers",
    footLinks: [
      { href: "/llms.txt", label: "llms.txt" },
      { href: "/developers/feature-requests", label: "Request a feature" },
    ],
    credentials: true,
    draft: false,
    articleClass: null,
  },
  guide: {
    name: "Guide",
    home: "/guide",
    nav: guideNav,
    title: "Threa User Guide",
    description: "How to use Threa: scratchpads, channels, memory, Ariadne and settings, in plain language.",
    searchLabel: "Search the guide",
    searchIndex: "/guide/search-index.json",
    headerLinks: [
      { href: "/developers", label: "Developers" },
      { href: "/llms.txt", label: "llms.txt" },
    ],
    sideFoot: [
      { href: "/developers", label: "Developer docs" },
      { href: "/llms.txt", label: "llms.txt" },
    ],
    footBrand: "Threa user guide",
    footLinks: [{ href: "/llms.txt", label: "llms.txt" }],
    credentials: false,
    draft: true,
    articleClass: "is-guide",
  },
} as const
const areaConfig = AREAS[area]
const { nav } = areaConfig
const { title = areaConfig.title, description = areaConfig.description } = Astro.props

// Each docs page has a markdown mirror at its own path + ".md" (generated by
// scripts/build-llms.ts after the build), advertised via <link rel="alternate">
// and a footer link so agents and agent-driven readers can fetch plain markdown.
const currentHref = nav.flatMap((g) => g.items).find((it) => it.slug === current)?.href
const markdownHref = currentHref
  ? currentHref === areaConfig.home
    ? `${areaConfig.home}/index.md`
    : `${currentHref}.md`
  : null

// When a page's sections carry group labels (the API reference groups by tag),
// render them as collapsible groups so a long list doesn't bury the rest of the
// nav. Pages without groups (short lists) render flat.
const subnavHasGroups = sections.some((s) => s.group)
const subnavGroups: { group: string; items: typeof sections }[] = []
for (const s of sections) {
  const key = s.group ?? ""
  const last = subnavGroups[subnavGroups.length - 1]
  if (last && last.group === key) last.items.push(s)
  else subnavGroups.push({ group: key, items: [s] })
}

// Breadcrumb structured data: Home → area → current page (the overview IS the
// area's home, so it contributes no third crumb).
const currentItem = nav.flatMap((g) => g.items).find((it) => it.slug === current)
const crumbs = [
  { name: "Threa", href: "/" },
  { name: areaConfig.name, href: areaConfig.home },
  ...(currentItem && currentItem.href !== areaConfig.home ? [{ name: currentItem.label, href: currentItem.href }] : []),
]
const schema: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: crumbs.map((c, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: c.name,
      item: new URL(c.href, Astro.site).href,
    })),
  },
]
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} ogType="article" schema={schema} />
    {markdownHref && <link rel="alternate" type="text/markdown" href={markdownHref} title="Markdown version of this page" />}
    <script is:inline define:vars={{ side: SIDE_WIDTH }}>
      /* Before first paint, so a stored sidebar width never jumps in. */
      try {
        const w = Number(localStorage.getItem(side.storageKey))
        if (w >= side.min && w <= side.max) document.documentElement.style.setProperty("--docs-side-w", `${w}px`)
      } catch {}
    </script>
  </head>
  <body class:list={["docs", split && "docs-split"]} data-search-index={areaConfig.searchIndex}>
    <SvgDefs />

    <header class="docs-nav">
      <div class="docs-nav-left">
        <button
          type="button"
          class="docs-menu-toggle"
          id="docs-menu-toggle"
          aria-expanded="false"
          aria-controls="docs-side"
          aria-label="Open navigation"
        >
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
            <path d="M2 4.5h14M2 9h14M2 13.5h14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
        </button>
        <a class="brand" href={areaConfig.home} style="text-decoration:none;">
          <svg><use href="#threa-mark" /></svg>
          <span class="wordmark">Threa</span>
          <span class="tag">{areaConfig.name}</span>
        </a>
      </div>
      <div class="ds-inline" id="ds-inline">
        <svg class="ds-glass" width="15" height="15" viewBox="0 0 16 16" aria-hidden="true">
            <circle cx="7" cy="7" r="4.75" fill="none" stroke="currentColor" stroke-width="1.6" />
            <path d="M10.5 10.5 14 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
        <input
          id="ds-inline-input"
          class="ds-inline-input"
          type="text"
          role="combobox"
          aria-label={areaConfig.searchLabel}
          aria-expanded="false"
          aria-controls="ds-inline-list"
          aria-autocomplete="list"
          autocomplete="off"
          spellcheck="false"
          placeholder={areaConfig.searchLabel}
        />
        <kbd class="ds-kbd" aria-hidden="true"></kbd>
        <div class="ds-pop">
          <ul class="ds-list" id="ds-inline-list" role="listbox" aria-label="Search results"></ul>
          <p class="ds-status" id="ds-inline-status" role="status"></p>
        </div>
      </div>
      <div class="docs-nav-right">
        <nav class="docs-nav-links">
          {areaConfig.headerLinks.map((l) => <a href={l.href}>{l.label}</a>)}
          <a class="home" href="/">↩ threa.io</a>
        </nav>
        <button type="button" class="ds-icon-btn" data-search-open aria-label={areaConfig.searchLabel}>
          <svg class="ds-glass" width="15" height="15" viewBox="0 0 16 16" aria-hidden="true">
            <circle cx="7" cy="7" r="4.75" fill="none" stroke="currentColor" stroke-width="1.6" />
            <path d="M10.5 10.5 14 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
        </button>
        <ThemeToggle />
        {areaConfig.credentials && (
          <button type="button" class="pg-toggle" id="pg-toggle" aria-expanded="false" aria-controls="pg-panel">
            <span class="pg-dot" id="pg-dot" data-state="idle"></span>
            <span id="pg-toggle-label">Credentials</span>
          </button>
        )}
      </div>
    </header>

    <dialog class="ds-dialog" id="ds-dialog" aria-label={areaConfig.searchLabel}>
      <div class="ds-dialog-bar">
        <svg class="ds-glass" width="15" height="15" viewBox="0 0 16 16" aria-hidden="true">
            <circle cx="7" cy="7" r="4.75" fill="none" stroke="currentColor" stroke-width="1.6" />
            <path d="M10.5 10.5 14 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
        <input
          id="ds-dialog-input"
          class="ds-dialog-input"
          type="text"
          role="combobox"
          aria-label={areaConfig.searchLabel}
          aria-expanded="true"
          aria-controls="ds-dialog-list"
          aria-autocomplete="list"
          autocomplete="off"
          spellcheck="false"
          enterkeyhint="go"
          placeholder={areaConfig.searchLabel}
        />
        <button type="button" class="ds-dialog-close" id="ds-dialog-close" aria-label="Close search">
          <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M3.5 3.5l9 9M12.5 3.5l-9 9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
        </button>
      </div>
      <ul class="ds-list" id="ds-dialog-list" role="listbox" aria-label="Search results"></ul>
      <p class="ds-status" id="ds-dialog-status" role="status"></p>
    </dialog>

    {areaConfig.credentials && (
      <>
      <!-- Credentials: set once, kept in this browser. Every code sample
           substitutes your real values into the {{tokens}}; runnable ones call
           the API. Tucked into a popover so it isn't always on screen. -->
      <div class="pg-panel" id="pg-panel" role="dialog" aria-label="Your API credentials" hidden>
        <div class="pg-panel-head">
          <span class="pg-bar-title">Credentials</span>
          <span class="pg-status" id="pg-status" data-state="idle">Not connected</span>
        </div>
        <div class="pg-fields">
          <div class="pg-field">
            <label for="pg-baseurl">Base URL</label>
            <div class="pg-field-input">
              <input id="pg-baseurl" type="text" spellcheck="false" autocomplete="off" placeholder="https://app.threa.io" />
            </div>
          </div>
          <div class="pg-field">
            <label for="pg-workspace">Workspace ID</label>
            <div class="pg-field-input">
              <input id="pg-workspace" type="text" spellcheck="false" autocomplete="off" placeholder="ws_…" />
            </div>
          </div>
          <div class="pg-field">
            <label for="pg-apikey">API key</label>
            <div class="pg-field-input">
              <input id="pg-apikey" type="password" spellcheck="false" autocomplete="off" placeholder="threa_uk_…" />
              <button type="button" class="pg-reveal" id="pg-reveal">Show</button>
            </div>
          </div>
        </div>
        <div class="pg-bar-foot">
          <p class="pg-bar-note">
            Kept in this browser. Sent only on requests you run, to the base URL
            above. Defaults to production.
          </p>
          <button type="button" class="pg-clear" id="pg-clear">Clear</button>
        </div>
      </div>
      </>
    )}

    <!-- Mobile drawer scrim: covers the page when the side nav is open and
         closes it on tap. Inert on desktop (the side nav is always in flow). -->
    <div class="docs-side-backdrop" id="docs-side-backdrop" hidden></div>

    <div class="docs-shell">
      <aside class="docs-side" id="docs-side">
        {nav.map((g) => (
          <div class="docs-side-group">
            <h4>{g.group}</h4>
            {g.items.map((it) => (
              <>
                {it.slug === current && sections.length > 0 ? (
                  <div class="docs-side-page">
                    <a href={it.href} class="current">{it.label}</a>
                    <button
                      type="button"
                      class="dsp-toggle"
                      aria-expanded="true"
                      aria-controls="docs-side-sub"
                      aria-label={`${it.label} sections`}
                    >
                      <svg class="dss-chevron" width="9" height="9" viewBox="0 0 16 16" aria-hidden="true">
                        <path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </button>
                  </div>
                ) : (
                  <a href={it.href} class={it.slug === current ? "current" : ""}>{it.label}</a>
                )}
                {it.slug === current && sections.length > 0 && (
                  subnavHasGroups ? (
                    <div class="docs-side-sub" id="docs-side-sub" data-collapsible>
                      {subnavGroups.map((g, gi) => (
                        <details class="dss-group" open={gi === 0}>
                          <summary class="dss-group-head">
                            <svg class="dss-chevron" width="9" height="9" viewBox="0 0 16 16" aria-hidden="true">
                              <path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                            <span>{g.group}</span>
                          </summary>
                          <div class="dss-group-items">
                            {g.items.map((s) => (
                              <a href={`#${s.id}`} data-section={s.id}>{s.label}</a>
                            ))}
                          </div>
                        </details>
                      ))}
                    </div>
                  ) : (
                    <div class="docs-side-sub" id="docs-side-sub">
                      {sections.map((s) => (
                        <a href={`#${s.id}`} data-section={s.id}>{s.label}</a>
                      ))}
                    </div>
                  )
                )}
              </>
            ))}
          </div>
        ))}

        <!-- Utility links that live in the top nav on desktop; surfaced here so
             the mobile drawer is a complete navigation surface. -->
        <div class="docs-side-foot">
          {areaConfig.sideFoot.map((l) => <a href={l.href}>{l.label}</a>)}
          <a href="/">↩ threa.io</a>
        </div>
      </aside>
      <div
        class="docs-side-resize"
        id="docs-side-resize"
        role="separator"
        tabindex="0"
        aria-orientation="vertical"
        aria-controls="docs-side"
        aria-label="Resize navigation"
        aria-valuemin={SIDE_WIDTH.min}
        aria-valuemax={SIDE_WIDTH.max}
      ></div>

      <main class="docs-main">
        {areaConfig.draft && (
          <p class="docs-draft-banner" role="note">
            <strong>Rough draft.</strong> This guide is still being written, so some articles are missing and details may
            be out of date. Building on Threa instead? See the <a href="/developers">developer docs</a>.
          </p>
        )}
        <article class:list={["docs-article", split && "is-split", areaConfig.articleClass]}>
          <slot />
        </article>

        <footer class="docs-foot">
          <span class="docs-foot-brand">{areaConfig.footBrand}</span>
          <ul class="docs-foot-links">
            {markdownHref && (
              <li><a href={markdownHref}>View as Markdown</a></li>
            )}
            {areaConfig.footLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
            <li><a href="/">threa.io</a></li>
          </ul>
        </footer>
      </main>
    </div>

    <script>
      import "../scripts/playground.ts"
      import "../scripts/search.ts"
      import "../scripts/docs-side.ts"
    </script>
  </body>
</html>
