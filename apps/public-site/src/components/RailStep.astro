---
/*
 * One guided step on the quickstart rail. The number comes from the parent
 * <ol class="rail">; scripts/guide.ts sets its state, fills the done note, and
 * compacts the body once the reader has finished it.
 */
interface Props {
  step: string
  id: string
  title: string
  state?: "todo" | "current"
}
const { step, id, title, state = "todo" } = Astro.props
---

<li class="rail-step" data-step={step} data-state={state}>
  <span class="rail-node" data-decorative aria-hidden="true"></span>
  <div class="rail-main">
    <div class="rail-head">
      <h2 id={id}>{title}</h2>
      <span class="rail-done-note" data-done-note></span>
      <button type="button" class="rail-toggle" data-step-toggle hidden>Show</button>
    </div>
    <div class="rail-body" data-step-body>
      <slot />
    </div>
  </div>
</li>
