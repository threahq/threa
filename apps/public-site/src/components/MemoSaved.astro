---
/*
 * The timeline line Threa posts when it keeps something
 * (apps/frontend/src/components/timeline/memo-captured-event.tsx).
 */
interface Props {
  title: string
}
const { title } = Astro.props
---

<p class="memo-saved">
  <svg aria-hidden="true"><use href="#icon-sparkles" /></svg>
  Saved to memory: <span class="memo-saved-title">{title}</span>
</p>
