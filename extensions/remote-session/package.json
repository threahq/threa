{
  "name": "@threa/remote-session",
  "version": "0.1.0",
  "description": "SDK for connecting an interactive agent runtime to a Threa scratchpad: session linking, claiming work, presence and claim renewal, /steer and /stop, attachments, and interim or final replies. A connector implements deliverTurn; the SDK runs the loop.",
  "keywords": [
    "threa",
    "bot",
    "agent",
    "runtime",
    "connector",
    "sdk"
  ],
  "license": "MIT",
  "homepage": "https://threa.io/developers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/threahq/threa.git",
    "directory": "extensions/remote-session"
  },
  "bugs": {
    "url": "https://github.com/threahq/threa/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun ../scripts/build-package.ts",
    "pack": "bun run build && cd dist && npm pack --pack-destination .."
  },
  "dependencies": {
    "@threa/bot-runtime-client": "file:../bot-runtime-client",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@hpke/core": "^1.9.0",
    "@hpke/dhkem-x25519": "^1.6.0",
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
