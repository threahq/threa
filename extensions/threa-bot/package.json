{
  "name": "@threahq/bot",
  "version": "0.1.0",
  "description": "Run any command as a Threa bot: `threa-bot run -- <command>` links a scratchpad (or answers mentions) and pipes each turn into the command, posting its output as the reply.",
  "keywords": [
    "threa",
    "bot",
    "agent",
    "cli",
    "connector"
  ],
  "license": "MIT",
  "homepage": "https://threa.io/developers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/threahq/threa.git",
    "directory": "extensions/threa-bot"
  },
  "bugs": {
    "url": "https://github.com/threahq/threa/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "threa-bot": "./src/cli.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun ../scripts/build-package.ts",
    "pack": "bun run build && cd dist && npm pack --pack-destination .."
  },
  "dependencies": {
    "@threahq/bot-runtime-client": "file:../bot-runtime-client",
    "@threahq/remote-session": "file:../remote-session",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
